# Copy to .env.local for local development. Set the same names in the hosting
# dashboard (Production and Preview). Never commit real values.

# Google Sheets (lead storage) — service account credentials
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Website audit — Google PageSpeed Insights API key (required for the audit)
PAGESPEED_API_KEY=

# Lead alert emails via Resend (optional; leads still go to the sheet without these)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=
